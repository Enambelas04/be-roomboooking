# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public base URL of THIS service. Used to build webhook callbacks that the
# mock gateway posts back to. Must be reachable by the gateway.
APP_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — SQLite for development, PostgreSQL for production.
# See README "SQLite -> PostgreSQL Migration".
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth — REQUIRED. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# Payments
#   PAYMENT_PROVIDER: mock | midtrans | xendit
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Platform commission, in basis points. 1000 bps = 10%.
# Allowed range per PRD: 800-1200 (8%-12%).
# ---------------------------------------------------------------------------
PLATFORM_FEE_BPS=1000

# Gateway fee, in basis points of the full payment. Default 0 for the mock.
GATEWAY_FEE_BPS=0

# ---------------------------------------------------------------------------
# Security / abuse protection
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=100kb

# Rate limits, requests per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Seed accounts (development only — change before any real deployment)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_HOST_EMAIL=host@example.com
SEED_HOST_PASSWORD=
